{
  "manifest_version": 3,
  "name": "Patternyze",
  "version": "1.0.1",
  "description": "天才Agent工程师的前端助手工具",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "debugger"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Patternyze · 采样网页组件",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "start-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "开始选择网页组件"
    }
  }
}
